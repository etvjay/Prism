{
  "_comment": "SECRET-FREE accounts-file template — no private keys, no mnemonics, no keystore secrets are committed. Copy to a local path outside the repo (e.g. ~/.starknet-accounts/starknet-accounts.json) and populate from env/keystore only.",
  "sepolia-deployer": {
    "address": "0x<SEPOLIA_DEPLOYER_ADDRESS_PLACEHOLDER>",
    "private_key_env_var": "STARKNET_SEPOLIA_DEPLOYER_PRIVATE_KEY",
    "keystore_env_var": "STARKNET_SEPOLIA_KEYSTORE_PATH",
    "public_key_env_var": "STARKNET_SEPOLIA_DEPLOYER_PUBLIC_KEY",
    "note": "All secret material is referenced by ENV VAR NAME, not value. The validator (ops/starknet/validate.mjs) rejects any key that looks like a real 32-byte hex secret."
  },
  "mainnet-deployer": {
    "_comment_release_gated": "Do not populate or use this profile until DEC-PRISM-OPS-001 ACCEPTS mainnet (ops/target-network/manifest.yaml).",
    "address": "0x<MAINNET_DEPLOYER_ADDRESS_PLACEHOLDER>",
    "private_key_env_var": "STARKNET_MAINNET_DEPLOYER_PRIVATE_KEY",
    "keystore_env_var": "STARKNET_MAINNET_KEYSTORE_PATH",
    "public_key_env_var": "STARKNET_MAINNET_DEPLOYER_PUBLIC_KEY"
  }
}
