# Select exactly one manifest environment; mainnet is an explicit release gate.
# Runtime/database profile is explicit in production. PostgreSQL is isolated by
# URL and schema; MAINNET never falls back to testnet.
PRISM_RUNTIME_PROFILE=TESTNET
PRISM_POSTGRES_TESTNET_URL=postgresql://user:password@localhost:5432/prism
# PRISM_POSTGRES_MAINNET_URL=postgresql://user:password@mainnet-db:5432/prism
# PRISM_POSTGRES_SCHEMA=prism_testnet
# PRISM_POSTGRES_MIGRATION_VERSION=1
# Legacy PRISM_POSTGRES_TEST_URL / PRISM_POSTGRES_URL are TESTNET-only aliases.
# The same variable names are used for testnet and mainnet.
PRISM_TARGET_ENV=testnet
STARKNET_CHAIN_ID=SN_SEPOLIA
STARKNET_RPC_URL=https://starknet-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Canonical deployed SN_SEPOLIA Registry V2. V1 remains legacy-only and must be
# selected explicitly with its own address/version in an isolated legacy runtime.
STARKNET_REGISTRY_VERSION=v2
STARKNET_REGISTRY_ADDRESS=0x06f77be5c7bdfef252dd322481b4430a587b781df4f79d3b344808d125ec530d
STARKNET_REGISTRY_CLASS_HASH=0x4349a331b4339c1f20ccdb745e2d60a194f8da64cb789bb70bf60463f42dd8d
PRISM_STARKNET_INDEXER_START_BLOCK=14015842
# Browser-visible RPC endpoint used by WalletAccountV6; never embed a secret in client code.
NEXT_PUBLIC_STARKNET_RPC_URL=https://starknet-sepolia.g.alchemy.com/v2/YOUR_PUBLIC_OR_RESTRICTED_KEY
# Expected browser wallet environment for the current testnet build.
NEXT_PUBLIC_STARKNET_NETWORK=SN_SEPOLIA

# Production-only reference. Do not use this mainnet pool from the default testnet build.
STRK20_MAINNET_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# App
NEXT_PUBLIC_APP_NAME=Prism
# Server-only HMAC key for signed app sessions (minimum 32 characters).
PRISM_APP_SESSION_SECRET=replace-with-a-random-32-byte-secret
PRISM_APP_SESSION_ISSUER=prism
PRISM_APP_SESSION_AUDIENCE=prism-api
# Signing values are environment-neutral across selected environments; never commit them.
# STARKNET_DEPLOYER_PRIVATE_KEY=<never commit>
# STARKNET_KEYSTORE_PATH=<never commit>
# BASE_SIGNER_PRIVATE_KEY=<never commit>
# Mainnet example (do not combine with the testnet values above):
# PRISM_TARGET_ENV=mainnet
# STARKNET_CHAIN_ID=SN_MAIN
# STARKNET_RPC_URL=https://<SN_MAIN-RPC>/v0_7
# NEXT_PUBLIC_STARKNET_NETWORK=SN_MAIN
# BASE_RPC_URL=https://<BASE_MAINNET-RPC>
# BASE_CHAIN_ID=8453
# Optional comma-separated session IDs/JTIs invalidated before expiry.
# PRISM_APP_SESSION_REVOKED_IDS=
